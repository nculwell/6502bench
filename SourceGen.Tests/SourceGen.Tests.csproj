<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(PortTargetFramework)</TargetFramework>
    <RootNamespace>SourceGen.Tests</RootNamespace>
    <AssemblyName>SourceGen.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SourceGen.Engine\SourceGen.Engine.csproj" />
    <!-- The terminal UI's presentation logic lives in its own project; it has no terminal
         dependency, so it can be exercised directly. -->
    <ProjectReference Include="..\SourceGen.Tui\SourceGen.Tui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine locates its data relative to the RuntimeData directory, and the
         regression tests read the sample projects from disk. -->
    <Content Include="..\SourceGen\RuntimeData\**\*"
             Link="RuntimeData\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\SourceGen\SGTestData\**\*"
             Link="SGTestData\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\SourceGen\Examples\**\*"
             Link="Examples\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
