<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SourceGen.Services.MessageDialog"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="16">
    <TextBlock Name="messageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="okButton" Content="OK" IsDefault="True" MinWidth="84" />
      <Button Name="cancelButton" Content="Cancel" IsCancel="True" MinWidth="84" />
    </StackPanel>
  </StackPanel>

</Window>
