<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SourceGen.Views.EditCommentDialog"
        Title="Edit Comment"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">
    <TextBlock Name="locationText" Foreground="Gray" />
    <TextBox Name="commentBox" Watermark="Comment text (leave empty to remove)" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="okButton" Content="OK" IsDefault="True" MinWidth="84" />
      <Button Name="cancelButton" Content="Cancel" IsCancel="True" MinWidth="84" />
    </StackPanel>
  </StackPanel>

</Window>
