<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SourceGen.Views.FindDialog"
        Title="Find"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="Search for:" />
    <TextBox Name="searchBox" Watermark="Text to find" />
    <CheckBox Name="matchCaseCheck" Content="Match case" />
    <TextBlock Name="statusText" Foreground="Gray" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="findPreviousButton" Content="Find Previous" MinWidth="110" />
      <Button Name="findButton" Content="Find Next" IsDefault="True" MinWidth="100" />
      <Button Name="closeButton" Content="Close" IsCancel="True" MinWidth="84" />
    </StackPanel>
  </StackPanel>

</Window>
