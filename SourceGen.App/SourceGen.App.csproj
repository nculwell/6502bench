<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PortTargetFramework)</TargetFramework>
    <RootNamespace>SourceGen</RootNamespace>
    <AssemblyName>SourceGen</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SourceGen.Engine\SourceGen.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.2" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.2" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The application locates its data files (system definitions, symbol files, extension
         scripts, help) in a RuntimeData directory beside the executable, so it must be part
         of the build and publish output. -->
    <Content Include="..\SourceGen\RuntimeData\**\*"
             Exclude="..\SourceGen\RuntimeData\bin\**;..\SourceGen\RuntimeData\obj\**">
      <Link>RuntimeData\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The string table stays owned by the engine so Res.Strings and the UI read the same
         file; it is pulled in here as an Avalonia resource dictionary. -->
    <AvaloniaResource Include="..\SourceGen.Engine\Res\Strings.xaml">
      <Link>Res\Strings.axaml</Link>
    </AvaloniaResource>
  </ItemGroup>

</Project>
