<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SourceGen.App"
             RequestedThemeVariant="Light">

  <Application.Styles>
    <!-- The window layouts were ported from WPF with fixed pixel widths sized for WPF's
         12px Segoe UI and tight padding.  Fluent defaults to 14px text and roomier
         controls, which clips buttons and headers, so use the compact density and a
         12px base font size. -->
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Window">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- WPF buttons center their content and use little padding; many buttons have
         fixed sizes that assume this. -->
    <Style Selector="Button, ToggleButton">
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Fluent DataGrid headers pad 12px on the left, too much for the narrow fixed-width
         columns ported from WPF (e.g. 53px "Offset"). -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Padding" Value="4,0,0,0" />
    </Style>
    <!-- Fluent gives cells their own 15px FontSize (so they don't inherit the window's)
         and a 32px minimum height. -->
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="18" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="18" />
    </Style>

    <!-- Avalonia ships DataGrid theming as a separate style include. -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- Fade command icons when the associated control is disabled.  In WPF this was a
         trigger inside the icon resource dictionary; Avalonia styles cannot live there. -->
    <Style Selector="Viewbox:disabled">
      <Setter Property="Opacity" Value="0.25" />
    </Style>

    <!-- Avalonia has no GroupBox, so the panes use HeaderedContentControl with a
         bordered box and a header line, matching the WPF look. -->
    <Style Selector="HeaderedContentControl">
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1" CornerRadius="2">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                         Margin="6,2,6,0" FontWeight="SemiBold" />
              <ContentPresenter Content="{TemplateBinding Content}" Margin="2" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <!-- Fluent sizes menus and other templated text from this resource, not from
           the inherited FontSize. -->
      <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
      <!-- By default the DataGrid reserves 32px in every column header for the sort
           arrow, and pads cell text by 12px. -->
      <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
      <Thickness x:Key="DataGridTextColumnCellTextBlockMargin">4,0,4,0</Thickness>
      <!-- Monospace font for the code list and data grids.  WPF used Consolas; the
           fallbacks cover Linux and macOS. -->
      <FontFamily x:Key="GeneralMonoFont">Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
      <ResourceDictionary.MergedDictionaries>
        <!-- Light and dark palettes; only one is merged at a time and the choice is
             applied at runtime from AppSettings. -->
        <ResourceInclude Source="avares://SourceGen/Res/Theme_Light.axaml" />
        <!-- The string table is owned by the engine so Res.Strings and XAML agree. -->
        <ResourceInclude Source="avares://SourceGen/Res/Strings.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
